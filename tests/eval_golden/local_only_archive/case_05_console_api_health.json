{
  "id": "EVAL-005-CONSOLE-API-HEALTH",
  "desc": "8800 生产级实时经营总台 REST API 存活与数据探针",
  "cmd": "curl.exe -s http://127.0.0.1:8800/api/live_state",
  "cwd": "${FED_LOCAL_ROOT}",
